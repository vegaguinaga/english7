  "grammar": [
    {
      "title": "Verb to be (ser / estar)",
      "explanation": "El verbo **to be** significa *ser* o *estar*. Cambia según la persona: **am**, **is**, **are**.\nEn conversación usamos contracciones: I am → **I'm**.",
      "table": {
        "headers": ["Persona", "Forma completa", "Contracción", "Español"],
        "rows": [
          ["I", "I am", "I'm", "yo soy / estoy"],
          ["You", "you are", "you're", "tú eres / estás"],
          ["He", "he is", "he's", "él es / está"],
          ["She", "she is", "she's", "ella es / está"],
          ["It", "it is", "it's", "eso es / está"],
          ["We", "we are", "we're", "nosotros somos / estamos"],
          ["They", "they are", "they're", "ellos son / están"]
        ]
      },
      "examples": [
        { "en": "I'm a student.", "es": "Soy estudiante." },
        { "en": "She is my teacher.", "es": "Ella es mi profesora." },
        { "en": "We are Nicaraguan.", "es": "Somos nicaragüenses." }
      ],
      "tip": "**I** (yo) siempre se escribe con mayúscula, aunque esté en medio de la oración."
    },
    {
      "title": "Negative and questions with to be",
      "explanation": "Para negar, agrega **not**: I am **not**, he is **not** (isn't), they are **not** (aren't).\nPara preguntar, pon el verbo **antes** de la persona: **Are you** Nicaraguan?",
      "table": {
        "headers": ["Afirmativo", "Negativo", "Pregunta"],
        "rows": [
          ["I am 12.", "I'm not 12.", "Am I…?"],
          ["He is Mexican.", "He isn't Mexican.", "Is he Mexican?"],
          ["They are friends.", "They aren't friends.", "Are they friends?"]
        ]
      },
      "examples": [
        { "en": "Are you a student? Yes, I am.", "es": "¿Eres estudiante? Sí, lo soy." },
        { "en": "Is she Honduran? No, she isn't.", "es": "¿Ella es hondureña? No, no lo es." }
      ],
      "tip": "En respuestas cortas afirmativas no se usa contracción: *Yes, I am.* (no *Yes, I'm.*)"
    },
    {
      "title": "Wh- questions for personal information",
      "explanation": "Usamos palabras de pregunta para pedir información personal.",
      "table": {
        "headers": ["Pregunta", "Respuesta", "Español"],
        "rows": [
          ["What's your name?", "My name is Ana.", "¿Cómo te llamas?"],
          ["How old are you?", "I'm 12 years old.", "¿Cuántos años tienes?"],
          ["Where are you from?", "I'm from Nicaragua.", "¿De dónde eres?"],
          ["What's your phone number?", "It's 8888-1234.", "¿Cuál es tu número de teléfono?"],
          ["How are you?", "I'm fine, thank you.", "¿Cómo estás?"]
        ]
      },
      "examples": [
        { "en": "Where are you from? I'm from Granada, Nicaragua.", "es": "¿De dónde eres? Soy de Granada, Nicaragua." },
        { "en": "How old is your brother? He is fifteen.", "es": "¿Cuántos años tiene tu hermano? Tiene quince." }
      ],
      "tip": "En inglés la edad se dice con **to be**: *I am 12* (no *I have 12*)."
    },
    {
      "title": "Possessive adjectives (my, your, his, her)",
      "explanation": "Indican de quién es algo. Van **antes** del sustantivo y no cambian en plural.",
      "table": {
        "headers": ["Persona", "Posesivo", "Ejemplo"],
        "rows": [
          ["I", "my", "**My** name is Luis."],
          ["you", "your", "What's **your** name?"],
          ["he", "his", "**His** name is Pedro."],
          ["she", "her", "**Her** name is Ana."],
          ["we", "our", "**Our** teacher is nice."],
          ["they", "their", "**Their** school is big."]
        ]
      },
      "examples": [
        { "en": "His name is Mario and her name is Rosa.", "es": "Él se llama Mario y ella se llama Rosa." }
      ],
      "tip": "**his** = de él, **her** = de ella. ¡No los confundas!"
    }
  ],


  "grammar": [
    {
      "title": "Have / has (tener)",
      "explanation": "Usamos **have** con I, you, we, they y **has** con he, she, it.\nEn negativo: **don't have** / **doesn't have**. En pregunta: **Do** you have…? / **Does** she have…?",
      "table": {
        "headers": ["Persona", "Afirmativo", "Negativo"],
        "rows": [
          ["I / You", "I **have** a sister.", "I **don't have** a brother."],
          ["He / She", "She **has** a cat.", "He **doesn't have** a dog."],
          ["We / They", "They **have** two kids.", "We **don't have** pets."]
        ]
      },
      "examples": [
        { "en": "Do you have any brothers? Yes, I do. I have two.", "es": "¿Tienes hermanos? Sí. Tengo dos." },
        { "en": "Does your father have a car? No, he doesn't.", "es": "¿Tu papá tiene carro? No." }
      ],
      "tip": "Con **doesn't** el verbo vuelve a **have**: *She doesn't have…* (no *doesn't has*)."
    },
    {
      "title": "Possessive 's (de)",
      "explanation": "Para decir de quién es algo, agrega **'s** al nombre de la persona.\n*El hermano de Ana* = **Ana's brother**.",
      "examples": [
        { "en": "Carlos is Ana's brother.", "es": "Carlos es el hermano de Ana." },
        { "en": "My mother's name is Rosa.", "es": "El nombre de mi mamá es Rosa." },
        { "en": "Luis is my uncle's son.", "es": "Luis es el hijo de mi tío." }
      ],
      "tip": "El orden es al revés que en español: primero el dueño, luego la cosa."
    },
    {
      "title": "Describing people",
      "explanation": "Para describir usamos **to be + adjetivo** o **have/has + rasgo**.\nEl adjetivo va **antes** del sustantivo y no cambia en plural.",
      "table": {
        "headers": ["Estructura", "Ejemplo", "Español"],
        "rows": [
          ["to be + adjective", "My father **is tall**.", "Mi papá es alto."],
          ["have/has + hair", "She **has long black hair**.", "Ella tiene el pelo largo y negro."],
          ["have/has + eyes", "He **has brown eyes**.", "Él tiene ojos cafés."]
        ]
      },
      "examples": [
        { "en": "My sisters are funny.", "es": "Mis hermanas son divertidas." },
        { "en": "My grandmother has short white hair.", "es": "Mi abuela tiene el pelo corto y blanco." }
      ],
      "tip": "Se dice *black hair* (no *hair black*) y *funny sisters* (no *funnys*)."
    },
    {
      "title": "Numbers 20–100",
      "explanation": "Para decir edades de adultos usamos las decenas y un guion: **twenty-one**, **thirty-five**.",
      "table": {
        "headers": ["Número", "En inglés"],
        "rows": [
          ["20", "twenty"], ["30", "thirty"], ["40", "forty"], ["50", "fifty"],
          ["60", "sixty"], ["70", "seventy"], ["80", "eighty"], ["90", "ninety"], ["100", "one hundred"]
        ]
      },
      "examples": [
        { "en": "My mother is forty-two years old.", "es": "Mi mamá tiene cuarenta y dos años." }
      ],
      "tip": "*forty* se escribe **sin u** (no *fourty*). Cuidado: *thirteen* (13) ≠ *thirty* (30)."
    }
  ],


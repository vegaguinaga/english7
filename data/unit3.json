  "grammar": [
    {
      "title": "A / an and plurals",
      "explanation": "Usamos **a** antes de sonido de consonante y **an** antes de sonido de vocal (a, e, i, o, u).\nPara el plural casi siempre agregamos **-s**. Con palabras que terminan en *-s, -sh, -ch, -x* agregamos **-es**.",
      "table": {
        "headers": ["Singular", "Plural", "Regla"],
        "rows": [
          ["a book", "two books", "+ s"],
          ["an eraser", "three erasers", "+ s"],
          ["a box", "two boxes", "+ es"],
          ["a dictionary", "two dictionaries", "y → ies"]
        ]
      },
      "examples": [
        { "en": "I have a pen and an eraser.", "es": "Tengo un lapicero y un borrador." },
        { "en": "There are five notebooks in my backpack.", "es": "Hay cinco cuadernos en mi mochila." }
      ],
      "tip": "*Scissors* siempre es plural: *The scissors **are** on the desk.*"
    },
    {
      "title": "This / that / these / those",
      "explanation": "Sirven para señalar cosas.\n**This / these** = cerca de mí. **That / those** = lejos de mí.",
      "table": {
        "headers": ["", "Cerca", "Lejos"],
        "rows": [
          ["Singular", "**this** book (este)", "**that** book (ese / aquel)"],
          ["Plural", "**these** books (estos)", "**those** books (esos / aquellos)"]
        ]
      },
      "examples": [
        { "en": "This is my pencil.", "es": "Este es mi lápiz." },
        { "en": "Those are my classmates.", "es": "Esos son mis compañeros." },
        { "en": "What's that? It's a ruler.", "es": "¿Qué es eso? Es una regla." }
      ],
      "tip": "Con *this/that* usa **is**; con *these/those* usa **are**."
    },
    {
      "title": "There is / there are (hay)",
      "explanation": "**There is** + singular, **there are** + plural. Los dos significan *hay*.\nPregunta: **Is there** a library? / **Are there** any computers?",
      "table": {
        "headers": ["", "Singular", "Plural"],
        "rows": [
          ["Afirmativo", "There **is** a board.", "There **are** 30 desks."],
          ["Negativo", "There **isn't** a pool.", "There **aren't** any computers."],
          ["Pregunta", "**Is there** a library?", "**Are there** any books?"]
        ]
      },
      "examples": [
        { "en": "Is there a cafeteria in your school? Yes, there is.", "es": "¿Hay cafetería en tu escuela? Sí, hay." },
        { "en": "There are twenty-eight students in my class.", "es": "Hay veintiocho estudiantes en mi clase." }
      ],
      "tip": "En español decimos *hay* para todo; en inglés depende si es uno (**is**) o varios (**are**)."
    },
    {
      "title": "Prepositions of place: in, on, under, next to",
      "explanation": "Dicen **dónde** está algo.",
      "table": {
        "headers": ["Preposición", "Significado", "Ejemplo"],
        "rows": [
          ["in", "dentro de", "The pen is **in** the backpack."],
          ["on", "sobre / encima de", "The book is **on** the desk."],
          ["under", "debajo de", "The backpack is **under** the chair."],
          ["next to", "al lado de", "Ana sits **next to** me."]
        ]
      },
      "examples": [
        { "en": "Where is my eraser? It's under your notebook.", "es": "¿Dónde está mi borrador? Está debajo de tu cuaderno." }
      ]
    }
  ],


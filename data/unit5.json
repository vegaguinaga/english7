  "grammar": [
    {
      "title": "Countable and uncountable nouns",
      "explanation": "Los sustantivos **contables** se pueden contar: *one egg, two eggs*.\nLos **incontables** no se cuentan y no tienen plural: *rice, water, milk, bread*.",
      "table": {
        "headers": ["Contable", "Incontable"],
        "rows": [
          ["an egg / two eggs", "rice"],
          ["a banana / three bananas", "water"],
          ["an orange / some oranges", "milk"],
          ["a tortilla / five tortillas", "cheese"]
        ]
      },
      "examples": [
        { "en": "I eat two bananas every day.", "es": "Como dos bananos cada día." },
        { "en": "I drink a lot of water.", "es": "Tomo mucha agua." }
      ],
      "tip": "Para contar incontables usa un recipiente: *a glass of milk, a cup of coffee, a bowl of soup*."
    },
    {
      "title": "Some / any",
      "explanation": "**some** = algo de / unos. Se usa en oraciones **afirmativas**.\n**any** = nada de / ningún. Se usa en **negativas** y **preguntas**.",
      "table": {
        "headers": ["", "Ejemplo", "Español"],
        "rows": [
          ["Afirmativo", "There is **some** milk.", "Hay algo de leche."],
          ["Negativo", "There isn't **any** juice.", "No hay nada de jugo."],
          ["Pregunta", "Are there **any** eggs?", "¿Hay huevos?"]
        ]
      },
      "examples": [
        { "en": "Can I have some water, please?", "es": "¿Me das agua, por favor?" },
        { "en": "We don't have any bread.", "es": "No tenemos pan." }
      ],
      "tip": "Cuando ofreces o pides algo con amabilidad, usa **some** aunque sea pregunta: *Would you like some juice?*"
    },
    {
      "title": "Like, love, don't like, hate",
      "explanation": "Para hablar de gustos usamos estos verbos + comida.\nCon **he/she** recuerda la **-s**: *She likes…* / *He doesn't like…*",
      "table": {
        "headers": ["Verbo", "Significado", "Ejemplo"],
        "rows": [
          ["love", "encantar", "I **love** mangoes. 😍"],
          ["like", "gustar", "I **like** chicken. 🙂"],
          ["don't like", "no gustar", "I **don't like** fish. 😕"],
          ["hate", "odiar", "I **hate** onions. 😖"]
        ]
      },
      "examples": [
        { "en": "Do you like vegetables? Yes, I do.", "es": "¿Te gustan las verduras? Sí." },
        { "en": "My sister doesn't like coffee.", "es": "A mi hermana no le gusta el café." }
      ],
      "tip": "En inglés la persona va primero: *I like rice* = *Me gusta el arroz*. ¡No digas *Me like*!"
    },
    {
      "title": "Ordering food: I'd like… / How much is it?",
      "explanation": "**I'd like** (= I would like) es una forma amable de pedir.\nPara preguntar el precio: **How much is it?** / **How much are they?**",
      "table": {
        "headers": ["Frase", "Español"],
        "rows": [
          ["What would you like?", "¿Qué desea?"],
          ["I'd like a quesillo, please.", "Quisiera un quesillo, por favor."],
          ["Anything to drink?", "¿Algo de tomar?"],
          ["How much is it?", "¿Cuánto es?"],
          ["It's fifty córdobas.", "Son cincuenta córdobas."]
        ]
      },
      "examples": [
        { "en": "I'd like a glass of orange juice, please.", "es": "Quisiera un vaso de jugo de naranja, por favor." }
      ],
      "tip": "*I'd like* es más educado que *I want*. Úsalo en restaurantes y tiendas."
    }
  ],

